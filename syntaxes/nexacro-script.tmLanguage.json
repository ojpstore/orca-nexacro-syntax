{
  "scopeName": "source.nexacro.script",
  "patterns": [
    {
      "include": "#js"
    }
  ],
  "repository": {
    "js": {
      "patterns": [
        {
          "name": "comment.block",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash",
          "match": "//.*$"
        },
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.numeric",
          "match": "\\b(0[xX][0-9a-fA-F]+|\\d+(\\.\\d+)?)\\b"
        },
        {
          "name": "constant.language",
          "match": "\\b(true|false|null|undefined|NaN|Infinity)\\b"
        },
        {
          "name": "keyword.control",
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|try|catch|finally|throw|in|with)\\b"
        },
        {
          "name": "keyword.control.new",
          "match": "\\b(new|delete|typeof|instanceof|void)\\b"
        },
        {
          "name": "storage.type",
          "match": "\\b(var|function)\\b"
        },
        {
          "name": "variable.language",
          "match": "\\bthis\\b"
        }
      ]
    }
  }
}